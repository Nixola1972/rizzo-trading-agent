# =============================================================================
# BOTONE V6 - CONFIGURAZIONE PRODUCTION
# =============================================================================
# Replica il sistema AI_INDEPENDENT di Arena V6
# Modello vincente dall'Arena: qwen/qwen3-235b-a22b-2507 + V6_FAST_PRUDENT
#
# USO:
#   python botone_v6.py --mode slow --loop   (AI decisions ogni 5 min)
#   python botone_v6.py --mode fast --loop   (Monitoring SL/TP ogni 5s)
# =============================================================================

# === BOT IDENTITY ===
BOT_NAME=botone-v6

# =============================================================================
# API KEYS
# =============================================================================

# OpenRouter API Key (OBBLIGATORIO)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# AI Model (cambia solo questo per provare altri modelli!)
# Modelli disponibili in Arena V6:
#   - qwen/qwen3-235b-a22b-2507       (WINNER - Qwen3 235B)
#   - deepseek/deepseek-v3.2-exp      (DeepSeek V3.2 Exp)
#   - deepseek/deepseek-chat          (DeepSeek V3)
#   - x-ai/grok-4.1-fast              (Grok 4.1 Fast)
#   - openai/gpt-oss-120b             (GPT-OSS 120B)
#   - moonshotai/kimi-k2-0905         (Kimi K2)
#   - tngtech/deepseek-r1t2-chimera:free  (FREE - DeepSeek Chimera)
#   - z-ai/glm-4.6:exacto             (FREE - GLM Exacto)
OPENROUTER_MODEL=qwen/qwen3-235b-a22b-2507

# =============================================================================
# HYPERLIQUID CREDENTIALS (SUB-ACCOUNT DEDICATO!)
# =============================================================================

HL_PRIVATE_KEY=0x_your_private_key_here
HL_ACCOUNT_ADDRESS=0x_your_wallet_address_here
HL_TESTNET=false

# =============================================================================
# V6 AI INDEPENDENT MODE
# =============================================================================

# Prompt Style (cambia questo per diversi stili di trading)
# Disponibili: PRUDENT, MODERATE, AGGRESSIVE, MACRO
#
# PRUDENT:    Win rate alto, pochi trade, max 3x leva, confidence > 80%
# MODERATE:   Bilanciato, confidence > 60%, leva 1-5x
# AGGRESSIVE: Molte opportunita, confidence > 50%, leva 5-10x
# MACRO:      Solo grandi trend (4h/1D), confidence > 85%, max 2x leva
V6_PROMPT_STYLE=PRUDENT

# Intervallo AI check (minuti) - Arena V6 usa 5 minuti
V6_AI_INTERVAL_MINUTES=5

# Timeframe per analisi
V6_TIMEFRAME=5min

# =============================================================================
# TRADING PARAMETERS (da V6_FAST_PRUDENT)
# =============================================================================

# Position sizing
POSITION_SIZE_USD=25

# Leverage massimo (PRUDENT consiglia max 3x)
MAX_LEVERAGE=3

# Stop Loss e Take Profit (percentuali sul P&L con leva)
STOP_LOSS_PCT=3.0
TAKE_PROFIT_PCT=4.0

# Simboli da tradare (separati da virgola)
TRADING_SYMBOLS=BTC,ETH,SOL

# =============================================================================
# TRAILING STOP (da V6_FAST_PRUDENT)
# =============================================================================
# Formato: profit_pct:lock_pct,profit_pct:lock_pct,...
#
# 2.0:0.0  -> A +2% profit, SL va a breakeven (0%)
# 3.0:1.0  -> A +3% profit, lock +1%
# 4.0:2.0  -> A +4% profit, lock +2%

TRAILING_ENABLED=true
TRAILING_STEPS=2.0:0.0,3.0:1.0,4.0:2.0

# Per trailing piu esteso (come .env.baseline originale):
# TRAILING_STEPS=2.5:0.0,3.5:1.0,4.5:1.5,5.0:2.0,6.0:3.0,7.5:4.5,8.5:5.5,10.0:7.0,12.5:9.5,15.0:12.0,17.5:14.0,20.0:16.0,25.0:21.0,30.0:26.0,35.0:31.0,40.0:36.0

# =============================================================================
# LOOP INTERVALS
# =============================================================================

SLOW_LOOP_INTERVAL=60    # Secondi tra check AI (slow loop)
FAST_LOOP_INTERVAL=5     # Secondi tra check SL/TP (fast loop)

# =============================================================================
# DATABASE (opzionale - per logging trade)
# =============================================================================

# DATABASE_URL=postgresql://tradingbot:password@memory_postgres:5432/botone_baseline

# =============================================================================
# NOTES
# =============================================================================
#
# 1. Per cambiare modello AI: modifica OPENROUTER_MODEL e riavvia
# 2. Per cambiare stile: modifica V6_PROMPT_STYLE e riavvia
# 3. I due container (slow + fast) condividono questa config
#
# DOCKER DEPLOYMENT:
#   docker build -t botone-v6 -f Dockerfile .
#
#   # SLOW container (AI decisions)
#   docker run -d --name botone_v6_slow \
#     --env-file .env.baseline \
#     --network unified-memory-stack_memory-net \
#     --entrypoint python botone-v6 \
#     botone_v6.py --mode slow --loop
#
#   # FAST container (monitoring)
#   docker run -d --name botone_v6_fast \
#     --env-file .env.baseline \
#     --network unified-memory-stack_memory-net \
#     --entrypoint python botone-v6 \
#     botone_v6.py --mode fast --loop
#
# =============================================================================
