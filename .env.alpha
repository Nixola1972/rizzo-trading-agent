# ============================================================
# AlphaTrader 1H Configuration
# ============================================================
# Config version: v2_trailing_5x (with trailing stop + 5x leverage)
# Based on MFE/MAE analysis of paper trading data

# Config tracking (increment when params change significantly)
ALPHA_CONFIG_VERSION=v2_trailing_5x

# Hold times (minutes)
# Golden zone: 30-45min, Death zone: >2h
ALPHA_MIN_HOLD_MINUTES=30
ALPHA_MAX_HOLD_MINUTES=90

# Take Profit / Stop Loss (scaled for 5x leverage)
# Original MFE/MAE @ 3x: winner MFE=0.98%, MAE=-0.39%
# Scaled for 5x: TP=1.5%, SL=5.0%
ALPHA_TAKE_PROFIT_PCT=1.5
ALPHA_STOP_LOSS_PCT=5.0

# Trailing Stop (scaled for 5x leverage)
# Original @ 3x: activate=0.5%, distance=0.3%
# Scaled for 5x: activate=0.8%, distance=0.5%
ALPHA_TRAILING_ACTIVATE_PCT=0.8
ALPHA_TRAILING_DISTANCE_PCT=0.5

# Position sizing
ALPHA_POSITION_USD=25.0
ALPHA_MAX_LEVERAGE=5

# Loop timing (seconds)
ALPHA_SLOW_INTERVAL=300

# Database
DATABASE_URL=postgresql://rizzo:rizzo@memory_postgres:5432/memory

# Trading symbols (comma-separated)
TRADING_SYMBOLS=BTC,ETH,SOL,SUI,DOGE,LINK,PEPE,XRP,ADA,AVAX,WIF
