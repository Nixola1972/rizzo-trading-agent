# ═══════════════════════════════════════════════════════════════════════════
# ALPHATRADER 1H CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# Configurazione per modello 1H con profit lock e trailing stop
# Data: 30 Dicembre 2025
# ═══════════════════════════════════════════════════════════════════════════

# --- Mode ---
ALPHA_PAPER=true  # Paper trading (cambia a false per LIVE)

# --- SIMBOLI (tutti 11 simboli trainati) ---
TRADING_SYMBOLS=BTC,ETH,SOL,DOGE,XRP,BNB,SUI,ARB,AVAX,LINK,ADA

# --- TIMING (basato su analisi paper trading) ---
# Sweet spot per 1H: 30-45 minuti
# >3 ore = disastroso
ALPHA_MIN_HOLD_MINUTES=30
ALPHA_MAX_HOLD_MINUTES=120

# --- Position Sizing ---
ALPHA_POSITION_USD=25
ALPHA_MAX_LEVERAGE=3

# --- STOP LOSS (iniziale, poi profit lock prende il controllo) ---
STOP_LOSS_PCT=2.5

# --- PROFIT LOCK (3 stadi basati su analisi MFE) ---
# Solo 35.3% dei trade raggiunge 0.5% MFE
# Stadio 1: 0.5% raggiunto -> blocca profitto a 0.2%
PROFIT_LOCK_1_TRIGGER=0.50
PROFIT_LOCK_1_SL=0.20

# Stadio 2: 0.9% raggiunto -> blocca profitto a 0.5%
PROFIT_LOCK_2_TRIGGER=0.90
PROFIT_LOCK_2_SL=0.50

# Stadio 3: Take Profit nativo (top trades)
HARD_TAKE_PROFIT_PCT=1.60

# --- Trade Cooldown ---
TRADE_COOLDOWN_MINUTES=10

# --- MCTS (disabilitato per ora, veto=OFF) ---
ALPHA_MIN_WIN_PROB=0.0

# --- Loop Intervals ---
# Slow loop: ogni 5 minuti per decisioni
# Fast loop: ogni 5 secondi per trailing (hardcoded)
ALPHA_SLOW_INTERVAL=300

# --- Interval ---
ALPHA_INTERVAL=1h

# --- HyperLiquid Credentials ---
# NOTA: PRIVATE_KEY, WALLET_ADDRESS, DATABASE_URL vengono da .env.baseline
# Non sovrascrivere qui - usa: --env-file .env.baseline --env-file .env.alpha.1h
TESTNET=false

# ═══════════════════════════════════════════════════════════════════════════
# ANALISI CHE HA PORTATO A QUESTA CONFIGURAZIONE
# ═══════════════════════════════════════════════════════════════════════════
#
# DATI PAPER TRADING (116 trade):
# - Win Rate: 57.8%
# - P&L Lordo: +2.38%
# - Avg P&L: +0.02% (troppo basso per coprire fees ~0.4%)
#
# ANALISI DURATA:
# - 30-45 min: Win Rate 58%, P&L positivo
# - >3 ore: Disastroso, perdite consistenti
#
# ANALISI MFE (Maximum Favorable Excursion):
# - 64.7% dei trade mai raggiunge 0.5% MFE
# - 35.3% raggiunge almeno 0.5%
# - Solo 19.8% raggiunge 1.0%
# - Solo 7.8% raggiunge 2.0%
#
# STRATEGIA "HARVEST":
# - TP basso (1.6%) per catturare profitti quando disponibili
# - Profit lock a stadi per proteggere i guadagni
# - Max hold time 120 min per evitare trade stagnanti
#
# ═══════════════════════════════════════════════════════════════════════════
