# ═══════════════════════════════════════════════════════════════════════════════
# BOTONE-BASELINE - Sentinel dedicato con trailing esteso
# Container: botone_baseline_slow + botone_baseline_fast
# Portafoglio: Sub-account HyperLiquid dedicato
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# AI CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=INSERISCI_LA_TUA_API_KEY
OPENROUTER_MODEL=deepseek/deepseek-v3.2-speciale

# ═══════════════════════════════════════════════════════════════════════════════
# ENTRY CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
# Score basso per entry frequente (come Arena V1_BASELINE)
SCORE_THRESHOLD_OPEN=15
SCORE_THRESHOLD_HOLD=10
SCORE_THRESHOLD_STRONG=25

# Double check AI prima di aprire
DOUBLE_CHECK_AI_ENABLED=true
TRADING_STYLE=moderate

# ═══════════════════════════════════════════════════════════════════════════════
# POSITION CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
POSITION_SIZE_USD=50
MICRO_GAIN_LEVERAGE=3
MAX_LEVERAGE=3

# ═══════════════════════════════════════════════════════════════════════════════
# EXIT CONFIGURATION - TRAILING ESTESO (NO TP FISSO)
# ═══════════════════════════════════════════════════════════════════════════════
# Stop Loss iniziale
MICRO_GAIN_STOP_LOSS_PERCENT=3.0
INITIAL_STOP_LOSS_PERCENT=3.0

# Take Profit DISABILITATO - lascia correre con trailing
TAKE_PROFIT_ENABLED=false
TAKE_PROFIT_PERCENT=50

# TRAILING ESTESO fino a 40%
# Format: profit_pct:sl_pct,profit_pct:sl_pct,...
# +2.5% -> SL 0% (breakeven)
# +3.5% -> SL +1% (primo lock profit)
# +4.5% -> SL +1.5%
# +5.0% -> SL +2%
# ... fino a +40% -> SL +36%
TRAILING_ENABLED=true
TRAILING_STEPS=2.5:0.0,3.5:1.0,4.5:1.5,5.0:2.0,6.0:3.0,7.5:4.5,8.5:5.5,10.0:7.0,12.5:9.5,15.0:12.0,17.5:14.0,20.0:16.0,25.0:21.0,30.0:26.0,35.0:31.0,40.0:36.0

# ═══════════════════════════════════════════════════════════════════════════════
# SYMBOLS
# ═══════════════════════════════════════════════════════════════════════════════
ENABLED_SYMBOLS=BTC,ETH,SOL

# ═══════════════════════════════════════════════════════════════════════════════
# HYPERLIQUID - SUB-ACCOUNT DEDICATO
# ═══════════════════════════════════════════════════════════════════════════════
HL_PRIVATE_KEY=INSERISCI_PRIVATE_KEY_SUB_ACCOUNT
HL_VAULT_ADDRESS=
HL_TESTNET=false

# ═══════════════════════════════════════════════════════════════════════════════
# TIMING
# ═══════════════════════════════════════════════════════════════════════════════
LOOP_INTERVAL_SLOW=60
LOOP_INTERVAL_FAST=8

# ═══════════════════════════════════════════════════════════════════════════════
# SAFETY LIMITS
# ═══════════════════════════════════════════════════════════════════════════════
MAX_TRADES_PER_DAY=10
MAX_CONCURRENT_POSITIONS=3

# ═══════════════════════════════════════════════════════════════════════════════
# TELEGRAM (opzionale)
# ═══════════════════════════════════════════════════════════════════════════════
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ═══════════════════════════════════════════════════════════════════════════════
# PATTERN DETECTION (opzionale)
# ═══════════════════════════════════════════════════════════════════════════════
PATTERN_DETECTION_ENABLED=false

# ═══════════════════════════════════════════════════════════════════════════════
# V6 AI INDEPENDENT MODE (for botone_v6.py)
# ═══════════════════════════════════════════════════════════════════════════════
# Prompt style: PRUDENT, MODERATE, AGGRESSIVE, MACRO
V6_PROMPT_STYLE=MODERATE

# AI call interval in minutes
V6_AI_INTERVAL_MINUTES=5

# Min profit % for AI to close position
MIN_PROFIT_TO_CLOSE=1.5

# AI can close if loss >= X% of stop loss (50 = 50% of SL)
AI_LOSS_THRESHOLD_PCT=50

# Leverage limits per style (MIN = minimum for trailing, MAX = maximum allowed)
# PRUDENT - Conservative trading
LEVERAGE_PRUDENT_MIN=2
LEVERAGE_PRUDENT_MAX=5

# MODERATE - Balanced approach
LEVERAGE_MODERATE_MIN=3
LEVERAGE_MODERATE_MAX=7

# AGGRESSIVE - High risk/reward
LEVERAGE_AGGRESSIVE_MIN=5
LEVERAGE_AGGRESSIVE_MAX=10

# MACRO - Long-term trend following
LEVERAGE_MACRO_MIN=2
LEVERAGE_MACRO_MAX=5

# ═══════════════════════════════════════════════════════════════════════════════
# RESEARCH MODE - Advanced Weighted Scoring System
# ═══════════════════════════════════════════════════════════════════════════════
# Enable research mode with academic-based indicator weights
RESEARCH_MODE=false

# Minimum volume ratio to allow trades (veto check)
RESEARCH_MIN_VOLUME_RATIO=0.5

# All available crypto symbols for trading
# Tier 1 (low risk): BTC, ETH
# Tier 2 (medium risk): SOL, XRP, BNB, SUI, ARB
# Tier 3 (high risk): DOGE, AVAX
TRADING_SYMBOLS=BTC,ETH,SOL

# Verbose logging shows all indicator values
VERBOSE_LOGGING=false

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE (PostgreSQL - usa la stessa rete del tuo stack)
# ═══════════════════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://user:password@postgres:5432/botone_baseline
# Oppure usa lo stesso DB ma con tabelle separate con prefix
