# ===========================================
# CONFIGURAZIONE per POSTGRESQL ESISTENTE
# ===========================================

# ----- HYPERLIQUID EXCHANGE -----
PRIVATE_KEY=your_ethereum_private_key_here
WALLET_ADDRESS=your_ethereum_wallet_address_here

# ----- AI PROVIDER CONFIGURATION -----
# Opzioni: 'openai' o 'openrouter'
AI_PROVIDER=openrouter

# ----- OPENAI API (se AI_PROVIDER=openai) -----
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxx
# Opzionale: modello OpenAI (default: gpt-4-turbo)
# OPENAI_MODEL=gpt-4o

# ----- OPENROUTER API (se AI_PROVIDER=openrouter) -----
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxx

# 🔥 Modelli raccomandati 2025 (scegli uno):
#
# 🏆 TOP PICK - DeepSeek (performance eccellenti + economicissimo!)
# - deepseek/deepseek-chat               (DeepSeek V3, $0.20/1M input) ✅ RACCOMANDATO!
# - deepseek/deepseek-r1                 (reasoning avanzato, paragonabile a OpenAI o1)
# - deepseek/deepseek-r1:free            (GRATIS! 🎉 Perfetto per testing)
#
# 💎 Altri modelli eccellenti:
# - anthropic/claude-4.5-sonnet          (top per coding, $3/1M)
# - anthropic/claude-3.7-sonnet          (hybrid reasoning, 200k context)
# - google/gemini-2.5-flash              (velocissimo, 1M context, economico)
# - openai/gpt-4o                        (all-rounder, $5/1M)
#
# Vedi SUPPORTED_MODELS_2025.md per lista completa e confronti!

OPENROUTER_MODEL=deepseek/deepseek-chat

# ----- COINMARKETCAP API -----
CMC_PRO_API_KEY=your_coinmarketcap_api_key_here

# ----- DATABASE POSTGRESQL (ESISTENTE) -----
# Formato con nome container (se nella stessa network Docker):
# postgresql://username:password@nome_container_postgres:5432/database_name
#
# Formato con host (se usi la porta esposta sull'host):
# postgresql://username:password@host.docker.internal:5432/database_name
#
# Esempio:
DATABASE_URL=postgresql://tradingbot:your_password@postgres_container_name:5432/rizzo_trading

# Network Docker del PostgreSQL esistente
# Esegui: docker inspect nome_container_postgres | grep NetworkMode
# Oppure: docker network ls
POSTGRES_NETWORK=nome_network_esistente

# ----- CONFIGURAZIONE BOT -----
TESTNET=true
VERBOSE=true
