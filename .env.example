# =============================================================================
# RIZZO TRADING BOT - CONFIGURAZIONE OTTIMALE
# =============================================================================
# Basato sull'analisi DATABASE_SUMMARY.md (4 Dic 2025)
#
# FINDINGS:
# - Score 13-16 = 60% win rate (OTTIMALE)
# - Score >20 = 24% win rate (PEGGIORE!)
# - MICRO_GAIN = unico mode profittevole
# - Max 25-30 trades/giorno per profittabilità
# =============================================================================

# Hyperliquid Connection
TESTNET=false
PRIVATE_KEY=your_private_key_here
WALLET_ADDRESS=your_wallet_address_here

# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# OpenAI (per AI trading decisions)
OPENAI_API_KEY=your_openai_api_key

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# =============================================================================
# SCORE THRESHOLDS (OTTIMIZZATI PER V2)
# =============================================================================
# Con Smart Score V2, i punteggi sono più alti (40-60 per segnali forti)
# Soglie alzate per ridurre chiamate AI e filtrare solo segnali forti
#
# Score < 20 = HOLD (non fare nulla - segnale troppo debole)
# Score 20-30 = MICRO_GAIN (chiama AI per conferma)
# Score > 30 = NORMAL (segnale forte, AI decide)
SCORE_THRESHOLD_HOLD=20
SCORE_THRESHOLD_OPEN=30

# =============================================================================
# SIMBOLI ABILITATI
# =============================================================================
# BTC ha le migliori performance
ENABLED_SYMBOLS=BTC

# =============================================================================
# DAILY LIMITS (IMPORTANTI!)
# =============================================================================
# 28-30 trades/giorno = profittevole
# 55+ trades/giorno = perdita
MAX_TRADES_PER_DAY=25
MAX_TOTAL_TRADES_PER_DAY=30
MIN_MINUTES_BETWEEN_TRADES=30
COOLDOWN_AFTER_LOSS_MINUTES=45

# =============================================================================
# MICRO_GAIN MODE (PROFITTEVOLE)
# =============================================================================
MICRO_GAIN_ENABLED=true
MICRO_GAIN_LEVERAGE=5
MICRO_GAIN_PORTION=0.30

# Take Profit: +1.5% P&L (circa +0.40 USDC su $30 margin)
MICRO_GAIN_TARGET_PERCENT=1.5

# Stop Loss: -1.0% P&L (circa -0.25 USDC su $30 margin)
# R/R Ratio = 1.5x
MICRO_GAIN_STOP_LOSS_PERCENT=1.0

# Trailing Stop a gradini
MICRO_GAIN_TRAILING_MODE=steps
MICRO_GAIN_TRAILING_ACTIVATION=0.5
MICRO_GAIN_TRAILING_GAP=0.3

# Gradini: pnl:sl (quando P&L raggiunge X%, SL va a Y%)
# Esempio: a +0.4% P&L, SL protegge +0.1%
MICRO_GAIN_TRAILING_STEPS=0.4:0.1,0.6:0.2,0.8:0.35,1.0:0.5,1.2:0.7,1.5:1.0

MICRO_GAIN_COOLDOWN_SECONDS=300
MICRO_GAIN_MAX_POSITIONS=1

# =============================================================================
# NORMAL MODE (DISABILITATO - win rate basso)
# =============================================================================
NORMAL_MODE_ENABLED=false
NORMAL_LEVERAGE=3
NORMAL_PORTION=0.25
NORMAL_TARGET_PERCENT=3.0
NORMAL_STOP_LOSS_PERCENT=2.0
NORMAL_TRAILING_ENABLED=true
NORMAL_TRAILING_MODE=steps
NORMAL_TRAILING_STEPS=1.0:0.0,1.5:0.5,2.0:1.0,2.5:1.5,3.0:2.0

# =============================================================================
# AI DECISION (DISABILITATO - 0% win rate!)
# =============================================================================
AI_DECISION_ENABLED=false
AI_CLOSE_CONFIRMATION=5
AI_MIN_PROFIT_FOR_CLOSE=0.5

# =============================================================================
# SENTINEL (MONITORAGGIO CONTINUO)
# =============================================================================
SENTINEL_ENABLED=true
SENTINEL_INTERVAL_SECONDS=30
SENTINEL_TELEGRAM_NOTIFY=true

# FAST/SLOW Mode Configuration (for split sentinel architecture)
# Run: python sentinel.py --mode fast --loop   (for FAST only)
# Run: python sentinel.py --mode slow --loop   (for SLOW only)
# Run: python sentinel.py --loop               (for both, legacy mode)
SENTINEL_FAST_INTERVAL=3          # Seconds between FAST checks (price, SL)
SENTINEL_SLOW_INTERVAL=30         # Seconds between SLOW checks (score, AI)
SENTINEL_WAKE_ON_TP=true
SENTINEL_WAKE_ON_SL=false
SENTINEL_WAKE_ON_TRAILING=true

# Log
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/app/logs/sentinel.log

# =============================================================================
# DOUBLE_CHECK AI VALIDATION
# =============================================================================
# Enable AI validation before opening positions
DOUBLE_CHECK_AI_ENABLED=true

# Trading style: free | aggressive | moderate | conservative
# - free: AI ha libertà totale, nessun vincolo rigido (CONSIGLIATO con V2)
# - aggressive: Entra su MACD forte, ignora RSI neutro
# - moderate: Richiede MACD + EMA confirmation
# - conservative: Richiede allineamento completo indicatori
TRADING_STYLE=free

# =============================================================================
# OPZIONALE - FEATURES AVANZATE
# =============================================================================
# Smoothing score (media ultimi N valori)
SCORE_SMOOTHING_SAMPLES=3
SCORE_CONFIRMATION_CYCLES=2

# Leverage scaling (aumenta leva quando in profitto protetto)
LEVERAGE_SCALING_ENABLED=false

# Auto Take Profit (piazza ordine TP dopo X minuti)
AUTO_TP_ENABLED=false
AUTO_TP_PERCENT=0.4
AUTO_TP_DELAY_MINUTES=15

# =============================================================================
# ATR DYNAMIC STEPS - Trailing adattivo alla volatilità
# =============================================================================
# Se abilitato, gli step del trailing vengono scalati in base all'ATR corrente
# Esempio: mercato volatile (ATR=2.5%) -> step più larghi
#          mercato calmo (ATR=0.8%) -> step più stretti
ATR_DYNAMIC_STEPS_ENABLED=true
ATR_BASE_PERCENT=1.5              # ATR% per cui hai tarato gli step originali
ATR_STEP_MULTIPLIER_MIN=0.5       # Non scalare sotto 0.5x (mercato troppo calmo)
ATR_STEP_MULTIPLIER_MAX=2.5       # Non scalare sopra 2.5x (mercato troppo volatile)

# =============================================================================
# BTC CORRELATION FILTER - Non tradare ALT contro BTC
# =============================================================================
# Se abilitato, blocca trade su ETH/SOL che vanno contro il trend di BTC
# Esempio: BTC bearish -> no LONG su ETH/SOL
#          BTC bullish -> no SHORT su ETH/SOL
BTC_CORRELATION_FILTER_ENABLED=true
BTC_CORRELATION_MACD_THRESHOLD=0.15  # MACD threshold per determinare trend BTC

# =============================================================================
# SMART SCORE V2 - Sistema di scoring avanzato
# =============================================================================
# Abilita il nuovo sistema di scoring con logica graduale e nuovi indicatori
# V2 include: Bollinger Bands, OBV, MACD Histogram, EMA Alignment, ADX filter
USE_SMART_SCORE_V2=true

# Pesi indicatori V2 (0-20, default ottimizzati)
WEIGHT_BOLLINGER=8.0              # Bollinger Bands position weight
WEIGHT_OBV_TREND=6.0              # On-Balance Volume trend weight
WEIGHT_MACD_HISTOGRAM=5.0         # MACD Histogram trend weight
WEIGHT_EMA_ALIGNMENT=7.0          # EMA20/EMA50 Golden/Death Cross weight
WEIGHT_RSI_MOMENTUM=6.0           # RSI in momentum zones (55-70 bull, 30-45 bear)

# ADX Filtering (riduce score in mercati ranging)
# ADX < 20 = mercato ranging, score viene ridotto progressivamente
ADX_WEAK_THRESHOLD=20.0           # Below this = ranging market penalty
ADX_STRONG_THRESHOLD=25.0         # Above this = confirmed trend (no penalty)

# Bollinger Bands thresholds
BB_SQUEEZE_THRESHOLD=2.0          # Bandwidth < 2% = squeeze detected

# =============================================================================
# SMART EXIT OPTIMIZER - Accelera trailing step quando trend gira
# =============================================================================
# IMPORTANTE: NON chiude posizioni, lavora IN SINERGIA col trailing esistente!
#
# Funzionalità:
# - Calcola P&L netto reale (fees apertura 0.045%, chiusura 0.045%, funding)
# - Analizza trend posizione vs trend di mercato
# - Suggerisce ACCELERATE (anticipa prossimo step) quando trend inverte
# - Il trailing stop esistente rimane INTATTO
#
# Fee Hyperliquid Tier 0: 0.045% taker per side = ~0.09% round trip
# Con leva 5x, breakeven = ~0.018% price move
#
SMART_EXIT_ENABLED=false          # Abilita/disabilita (default: false)
SMART_EXIT_HISTORY_SIZE=100       # Letture prezzo per trend (100 × 3s = 5 min storia)
SMART_EXIT_TREND_WINDOW=30        # Finestra per calcolo slope trend
SMART_EXIT_MIN_PROFIT=0.3         # % minimo netto per considerare ACCELERATE
SMART_EXIT_ACCELERATE_CONFIDENCE=75  # Confidence minima per eseguire ACCELERATE
#
# AI Decision (opzionale, per casi dubbi)
SMART_EXIT_AI_ENABLED=false       # Usa AI per decisioni incerte (40-80% confidence)

# =============================================================================
# PATTERN DETECTION - Double Bottom (W) / Double Top (M)
# =============================================================================
# Rileva pattern di inversione per migliorare timing entry/exit
#
# Double Bottom (W): Pattern bullish - due minimi simili con RSI divergence
# Double Top (M): Pattern bearish - due massimi simili con RSI divergence
#
# Entry: Pattern aggiunge punti allo score + AI vede info pattern
# Exit: Se pattern contrario rilevato durante posizione → ACCELERATE SL

PATTERN_DETECTION_ENABLED=true    # Abilita rilevamento pattern
PATTERN_DETECTION_TIMEFRAME=1h    # Timeframe per analisi (15m, 1h, 4h)
PATTERN_LOOKBACK_CANDLES=100      # Candele da analizzare (~4 giorni su 1h)
PATTERN_CACHE_SECONDS=300         # Refresh cache ogni 5 min (pattern cambiano lentamente)

# Parametri rilevamento
PATTERN_PRICE_TOLERANCE_PCT=2.0   # Tolleranza tra i due minimi/massimi (%)
PATTERN_MIN_DISTANCE_CANDLES=10   # Minimo candele tra primo e secondo low/high
PATTERN_RSI_DIVERGENCE_MIN=5      # Minima divergenza RSI richiesta
PATTERN_MIN_CONFIDENCE=0.60       # Confidence minima per considerare pattern valido

# Score weights
WEIGHT_DOUBLE_BOTTOM=12.0         # Punti aggiunti a score bullish
WEIGHT_DOUBLE_TOP=12.0            # Punti aggiunti a score bearish

# Entry system
# IMMEDIATE: Entra subito quando AI approva
# FAST_LOOP: Aspetta breakout della neckline (consigliato)
PATTERN_ENTRY_SYSTEM=FAST_LOOP
PATTERN_ENTRY_EXPIRY_MINUTES=120  # Scadenza pending entry (2 ore)
PATTERN_ENTRY_CONFIRM_VOLUME=true # Richiedi conferma volume
PATTERN_ENTRY_VOLUME_MULTIPLIER=1.5  # Volume > 1.5x media

# Exit system (pattern contrario)
# CLOSE: Chiude posizione immediatamente
# ACCELERATE: Stringe SL per proteggere profitto (consigliato)
# REDUCE_50: Chiude 50% posizione
# ALERT_ONLY: Solo log, nessuna azione
PATTERN_CONTRA_ACTION=ACCELERATE
PATTERN_CONTRA_MIN_CONFIDENCE=0.70  # Confidence minima per trigger azione

# Stop Loss da pattern
PATTERN_SL_USE_ATR=true           # Usa ATR per SL dinamico
PATTERN_SL_ATR_MULTIPLIER=1.5     # SL = entry ± (1.5 × ATR)
