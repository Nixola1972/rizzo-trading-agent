# ===========================================
# CONFIGURAZIONE RIZZO TRADING AGENT
# ===========================================

# ----- HYPERLIQUID EXCHANGE -----
# Ottieni questi dati dal tuo wallet Ethereum
# ATTENZIONE: Non condividere mai la private key!
PRIVATE_KEY=your_ethereum_private_key_here
WALLET_ADDRESS=your_ethereum_wallet_address_here

# ----- OPENAI API -----
# Registrati su: https://platform.openai.com/api-keys
# Serve per far decidere l'AI sulle operazioni di trading
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxx

# ----- COINMARKETCAP API -----
# Registrati su: https://coinmarketcap.com/api/
# Piano gratuito: 10,000 chiamate/mese
# Serve per il Fear & Greed Index (sentiment)
CMC_PRO_API_KEY=your_coinmarketcap_api_key_here

# ----- DATABASE POSTGRESQL -----
# Formato: postgresql://username:password@host:port/database_name
# Esempio: postgresql://trading_user:mypassword@localhost:5432/trading_bot
DATABASE_URL=postgresql://user:password@localhost:5432/rizzo_trading

# ----- CONFIGURAZIONE BOT -----
# TESTNET: true per testare senza soldi veri, false per mainnet
TESTNET=true

# VERBOSE: mostra più informazioni nei log
VERBOSE=true
