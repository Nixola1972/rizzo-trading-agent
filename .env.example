# ============================================
# TRADING BOT CONFIGURATION
# ============================================
# Copia questo file in .env e modifica i valori

# --- API Keys ---
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=deepseek/deepseek-r1
DATABASE_URL=postgresql://user:password@host:5432/dbname
PRIVATE_KEY=your_hyperliquid_private_key
WALLET_ADDRESS=your_wallet_address

# --- Bot Settings ---
TESTNET=false
VERBOSE=true
AI_PROVIDER=openrouter

# --- Timeouts ---
BOT_TIMEOUT_SECONDS=300
DB_CONNECT_TIMEOUT=30
DB_QUERY_TIMEOUT=60000

# --- Telegram ---
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_NOTIFY_HOLDS=false


# ============================================
# SIGNAL SCORING WEIGHTS
# ============================================
# Sistema di pesi per determinare la direzione del trade (LONG/SHORT/HOLD)
# Ogni peso va da 0 a 20 - valori più alti = maggiore importanza
# Per disabilitare un segnale, imposta il peso a 0

# ----------------------------------------
# SEGNALI BEARISH (favoriscono SHORT)
# ----------------------------------------

# WEIGHT_FEAR_GREED_FEAR (default: 8)
# Peso quando Fear & Greed Index < 30 (mercato in paura)
# - Valore alto: Il bot considera SHORT quando c'è paura nel mercato
# - Logica: Paura = possibile continuazione del ribasso
# Range consigliato: 5-12
WEIGHT_FEAR_GREED_FEAR=8

# WEIGHT_RSI_OVERBOUGHT (default: 15)
# Peso quando RSI > 70 (prezzo troppo alto, ipercomprato)
# - Valore alto: Il bot apre SHORT quando RSI indica ipercomprato
# - Logica: RSI > 70 = probabile correzione al ribasso
# Range consigliato: 10-20 (indicatore molto affidabile)
WEIGHT_RSI_OVERBOUGHT=15

# WEIGHT_TREND_BEARISH (default: 10)
# Peso quando Prezzo < EMA20 E MACD < 0 (trend ribassista confermato)
# - Valore alto: Il bot segue il trend ribassista
# - Logica: Due indicatori concordi = segnale forte
# Range consigliato: 8-15
WEIGHT_TREND_BEARISH=10

# WEIGHT_FORECAST_NEGATIVE (default: 6)
# Peso quando Prophet prevede un ribasso > 0.3%
# - Valore alto: Il bot si fida delle previsioni Prophet
# - Logica: ML prediction + altri indicatori = conferma
# Range consigliato: 4-10
WEIGHT_FORECAST_NEGATIVE=6

# WEIGHT_MACD_NEGATIVE (default: 5)
# Peso quando MACD < 0 (momentum negativo) senza conferma EMA
# - Usato quando trend non confermato ma MACD segnala debolezza
# Range consigliato: 3-8
WEIGHT_MACD_NEGATIVE=5

# WEIGHT_VOLUME_BEARISH (default: 4)
# Peso quando Volume Ask > Volume Bid * 1.5 (venditori dominano)
# - Valore alto: Il bot considera il volume come conferma
# Range consigliato: 2-8
WEIGHT_VOLUME_BEARISH=4


# ----------------------------------------
# SEGNALI BULLISH (favoriscono LONG)
# ----------------------------------------

# WEIGHT_FEAR_GREED_GREED (default: 8)
# Peso quando Fear & Greed Index > 60 (mercato euforico)
# - Valore alto: Il bot considera LONG quando c'è euforia
# - ATTENZIONE: Extreme Greed (>80) potrebbe indicare top
# Range consigliato: 5-12
WEIGHT_FEAR_GREED_GREED=8

# WEIGHT_RSI_OVERSOLD (default: 15)
# Peso quando RSI < 30 (prezzo troppo basso, ipervenduto)
# - Valore alto: Il bot apre LONG quando RSI indica ipervenduto
# - Logica: RSI < 30 = probabile rimbalzo al rialzo
# Range consigliato: 10-20 (indicatore molto affidabile)
WEIGHT_RSI_OVERSOLD=15

# WEIGHT_TREND_BULLISH (default: 10)
# Peso quando Prezzo > EMA20 E MACD > 0 (trend rialzista confermato)
# - Valore alto: Il bot segue il trend rialzista
# - Logica: Due indicatori concordi = segnale forte
# Range consigliato: 8-15
WEIGHT_TREND_BULLISH=10

# WEIGHT_FORECAST_POSITIVE (default: 6)
# Peso quando Prophet prevede un rialzo > 0.3%
# - Valore alto: Il bot si fida delle previsioni Prophet
# Range consigliato: 4-10
WEIGHT_FORECAST_POSITIVE=6

# WEIGHT_MACD_POSITIVE (default: 5)
# Peso quando MACD > 0 (momentum positivo) senza conferma EMA
# Range consigliato: 3-8
WEIGHT_MACD_POSITIVE=5

# WEIGHT_VOLUME_BULLISH (default: 4)
# Peso quando Volume Bid > Volume Ask * 1.5 (compratori dominano)
# Range consigliato: 2-8
WEIGHT_VOLUME_BULLISH=4


# ----------------------------------------
# SOGLIE DECISIONALI
# ----------------------------------------

# SCORE_THRESHOLD_OPEN (default: 15)
# Score minimo (in valore assoluto) per aprire una posizione
# - Net Score > +15 = Apri LONG
# - Net Score < -15 = Apri SHORT
# - |Net Score| < 15 = HOLD
# Range consigliato: 10-20
SCORE_THRESHOLD_OPEN=15

# SCORE_THRESHOLD_STRONG (default: 25)
# Score per segnale forte (può usare più leva o size maggiore)
# Range consigliato: 20-35
SCORE_THRESHOLD_STRONG=25

# SCORE_THRESHOLD_HOLD (default: 10)
# Score sotto il quale il segnale è troppo debole per agire
# Range consigliato: 5-15
SCORE_THRESHOLD_HOLD=10


# ----------------------------------------
# SOGLIE INDICATORI
# ----------------------------------------

# RSI_OVERBOUGHT_THRESHOLD (default: 70)
# Valore RSI sopra il quale si considera ipercomprato
# Range standard: 65-80
RSI_OVERBOUGHT_THRESHOLD=70

# RSI_OVERSOLD_THRESHOLD (default: 30)
# Valore RSI sotto il quale si considera ipervenduto
# Range standard: 20-35
RSI_OVERSOLD_THRESHOLD=30

# FEAR_GREED_FEAR_THRESHOLD (default: 30)
# Valore F&G sotto il quale si considera "paura"
# Range standard: 25-40
FEAR_GREED_FEAR_THRESHOLD=30

# FEAR_GREED_GREED_THRESHOLD (default: 60)
# Valore F&G sopra il quale si considera "avidita"
# Range standard: 55-70
FEAR_GREED_GREED_THRESHOLD=60

# FORECAST_MIN_CHANGE_PCT (default: 0.3)
# Minimo cambio % previsto per considerare il forecast significativo
# Range consigliato: 0.2-0.5
FORECAST_MIN_CHANGE_PCT=0.3


# ----------------------------------------
# ANTI-OVERTRADING
# ----------------------------------------

# MIN_PRICE_CHANGE_PCT (default: 0.3)
# Minimo movimento % atteso per aprire una posizione
# Evita di tradare quando il prezzo non si muove abbastanza
# Range consigliato: 0.2-0.5
MIN_PRICE_CHANGE_PCT=0.3

# MIN_MINUTES_BETWEEN_TRADES (default: 30)
# Minuti minimi tra un trade e l'altro sullo stesso symbol
# Evita overtrading e riduce le fee
# Range consigliato: 15-60
MIN_MINUTES_BETWEEN_TRADES=30


# ----------------------------------------
# RISK MANAGEMENT
# ----------------------------------------

# MAX_POSITION_SIZE_PCT (default: 50)
# Percentuale massima del portafoglio che una singola operazione puo' utilizzare
# Esempio: se portafoglio = $100 e MAX_POSITION_SIZE_PCT = 50
#          il massimo investimento per singola operazione = $50
# - Valore 100: Nessun limite (puo' usare tutto il portafoglio)
# - Valore 50: Massimo 50% del portafoglio per operazione
# - Valore 25: Massimo 25% del portafoglio per operazione (molto conservativo)
# Range consigliato: 25-75
# IMPORTANTE: Questo limite si applica PRIMA della leva
MAX_POSITION_SIZE_PCT=50


# ----------------------------------------
# TRAILING STOP & POSITION PROTECTION
# ----------------------------------------

# TRAILING_STOP_ENABLED (default: true)
# Abilita il trailing stop dinamico per proteggere i profitti
# - true: Attiva trailing stop
# - false: Disattiva (usa solo stop loss fisso)
TRAILING_STOP_ENABLED=true

# TRAILING_STOP_PERCENT (default: 7)
# Percentuale di discesa dal prezzo massimo (LONG) o risalita dal minimo (SHORT)
# che triggera la chiusura della posizione
# Esempio LONG: Prezzo max raggiunto $115, trailing 7% = chiudi se scende sotto $107
# Esempio SHORT: Prezzo min raggiunto $85, trailing 7% = chiudi se sale sopra $91
# Range consigliato: 5-10
TRAILING_STOP_PERCENT=7

# TRAILING_STOP_ACTIVATION_PERCENT (default: 3)
# Profitto minimo (%) prima che il trailing stop si attivi
# Prima di questo profitto, si usa solo lo stop loss fisso
# Esempio: Se attivazione = 3%, trailing si attiva solo dopo +3% di profitto
# Range consigliato: 2-5
TRAILING_STOP_ACTIVATION_PERCENT=3

# INITIAL_STOP_LOSS_PERCENT (default: 10)
# Stop loss fisso iniziale (%) prima che il trailing si attivi
# Protegge il capitale se la posizione va subito in perdita
# Range consigliato: 5-15
INITIAL_STOP_LOSS_PERCENT=10


# ----------------------------------------
# PROTEZIONE CHIUSURE PREMATURE
# ----------------------------------------

# SCORE_THRESHOLD_CLOSE_REVERSAL (default: 10)
# Score minimo (in valore assoluto) nella direzione opposta per chiudere una posizione
# - Se hai uno SHORT e score > +10 = chiudi (inversione confermata)
# - Se hai un LONG e score < -10 = chiudi (inversione confermata)
# - Se score non ha raggiunto questa soglia = HOLD (mantieni posizione)
# Questo evita che l'AI chiuda prematuramente posizioni ancora valide
# Range consigliato: 8-15
SCORE_THRESHOLD_CLOSE_REVERSAL=10


# ----------------------------------------
# SENTINEL (Monitoraggio Continuo)
# ----------------------------------------

# SENTINEL_ENABLED (default: true)
# Abilita il sentinel per monitoraggio continuo trailing stop
# Il sentinel gira separatamente dal bot principale e controlla i prezzi piu' frequentemente
SENTINEL_ENABLED=true

# SENTINEL_INTERVAL_SECONDS (default: 60)
# Intervallo in secondi tra ogni controllo del sentinel
# - 60: Ogni minuto (raccomandato con take profit attivo)
# - 120: Ogni 2 minuti
# - 300: Ogni 5 minuti (meno reattivo)
# Range consigliato: 60-120
SENTINEL_INTERVAL_SECONDS=60

# SENTINEL_TELEGRAM_NOTIFY (default: true)
# Invia notifica Telegram quando il sentinel chiude una posizione
SENTINEL_TELEGRAM_NOTIFY=true


# ----------------------------------------
# TAKE PROFIT
# ----------------------------------------

# TAKE_PROFIT_ENABLED (default: true)
# Abilita il take profit automatico nel sentinel
# Chiude la posizione quando raggiunge un certo profitto
TAKE_PROFIT_ENABLED=true

# TAKE_PROFIT_PERCENT (default: 5)
# Percentuale di profitto (sul P&L reale, considera la leva) per chiudere
# Esempio: Con 5x leva, +1% prezzo = +5% P&L reale
# - 3%: Prendi profitto frequentemente
# - 5%: Bilanciato (raccomandato)
# - 10%: Solo profitti significativi
# Range consigliato: 3-10
TAKE_PROFIT_PERCENT=5

# TAKE_PROFIT_TRIGGER_BOT (default: true)
# Dopo un take profit, lancia automaticamente il bot per rivalutare
# il simbolo e potenzialmente riaprire la posizione se il segnale e' ancora forte
TAKE_PROFIT_TRIGGER_BOT=true


# ----------------------------------------
# MICRO-GAIN MODE
# ----------------------------------------
# Sistema per gestire segnali intermedi (score tra HOLD e OPEN)
# con target di profitto ridotti per coprire costi e uscita rapida

# MICRO_GAIN_ENABLED (default: false)
# Abilita la modalita' micro-gain per segnali intermedi
# - Score < SCORE_THRESHOLD_HOLD = HOLD (nessuna azione)
# - Score tra HOLD e OPEN = MICRO_GAIN (target rapido)
# - Score >= SCORE_THRESHOLD_OPEN = NORMAL (trailing stop)
MICRO_GAIN_ENABLED=false

# MICRO_GAIN_TARGET_PERCENT (default: 0.15)
# Target profit % (P&L con leva) per chiudere in modalita' micro-gain
# Deve coprire: fee apertura (0.035%) + fee chiusura (0.035%) + costo AI (~0.01%)
# Con leva 5x: target 0.15% P&L = 0.03% movimento prezzo
# Range consigliato: 0.10-0.25
MICRO_GAIN_TARGET_PERCENT=0.15

# MICRO_GAIN_REVERSAL_SCORE (default: 5)
# Se lo score inverte e supera questa soglia, chiudi la posizione
# Per LONG: chiudi se quick_score < -REVERSAL_SCORE
# Per SHORT: chiudi se quick_score > +REVERSAL_SCORE
# Range consigliato: 3-10
MICRO_GAIN_REVERSAL_SCORE=5

# MICRO_GAIN_USE_LIMIT_ORDER (default: true)
# Piazza automaticamente un limit order TP su Hyperliquid
# - true: TP order piazzato all'apertura, chiusura automatica
# - false: Solo sentinel controlla e chiude manualmente
MICRO_GAIN_USE_LIMIT_ORDER=true
