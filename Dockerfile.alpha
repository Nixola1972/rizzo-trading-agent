# =============================================================================
# AlphaTrader Docker Container
# =============================================================================
#
# Build:
#   docker build -t alphatrader -f Dockerfile.alpha .
#
# Run Training:
#   docker run -d --name alpha_training \
#     -v $(pwd)/alpha/data:/app/alpha/data \
#     -v $(pwd)/alpha/checkpoints:/app/alpha/checkpoints \
#     alphatrader train
#
# Run Trading (Paper):
#   docker run -d --name alpha_trader \
#     -v $(pwd)/alpha/checkpoints:/app/alpha/checkpoints \
#     --env-file .env \
#     alphatrader trade-paper
#
# Check Progress:
#   docker logs -f alpha_training
#
# =============================================================================

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install AWS CLI (for S3 data download)
RUN curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip" \
    && unzip awscliv2.zip \
    && ./aws/install \
    && rm -rf aws awscliv2.zip

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install PyTorch CPU version (separate command to use correct index)
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# Install lz4, pyarrow and other AlphaTrader dependencies (from PyPI)
RUN pip install --no-cache-dir lz4 pyarrow

# Copy application code
COPY . .

# Create directories for data and checkpoints
RUN mkdir -p alpha/data alpha/checkpoints

# Copy and setup entrypoint script
COPY alpha/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["--help"]
