# ===========================================
# Trade Skill MES/MRP/WMS — Configurazione
# ===========================================

# Database PostgreSQL (Supabase o locale)
MES_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mes_tradeskill

# Supabase (alternativa — opzionale)
# MES_SUPABASE_URL=https://xxxxx.supabase.co
# MES_SUPABASE_KEY=eyJxxxxx

# App
MES_DEBUG=true
MES_SECRET_KEY=cambiami-in-produzione-chiave-segreta-lunga

# Telegram Bot (per registrazione produzione Albania)
MES_TELEGRAM_BOT_TOKEN=
MES_OPENAI_API_KEY=       # per Whisper speech-to-text
MES_ANTHROPIC_API_KEY=    # per interpretazione vocale con Claude

# Danea Easyfatt sync paths
# MES_DANEA_EXPORT_PATH=/path/to/danea/export
# MES_DANEA_IMPORT_PATH=/path/to/danea/import

# Danea Bridge Agent — URL del tunnel Cloudflare verso il PC locale
# Il Bridge Agent gira sul PC con Danea e viene esposto via Cloudflare Tunnel
# Esempio con tunnel temporaneo: https://random-words.trycloudflare.com
# Esempio con dominio custom:   https://danea.tradeskill.it
MES_DANEA_BRIDGE_URL=

# Access DB (gestionale Riccardo) — Fase 2
# MES_ACCESS_DB_PATH=/path/to/database.accdb
