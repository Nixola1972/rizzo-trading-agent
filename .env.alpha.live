# ═══════════════════════════════════════════════════════════════════════════
# ALPHATRADER LIVE CONFIGURATION - 15m Model
# ═══════════════════════════════════════════════════════════════════════════
# Configurazione ottimizzata basata su analisi paper trading (2107 trades)
# Data: 30 Dicembre 2025
# Portfolio: ~$220
# ═══════════════════════════════════════════════════════════════════════════

# --- Mode ---
ALPHA_PAPER=false  # LIVE MODE!

# --- SIMBOLI OTTIMIZZATI (solo profittevoli dopo fees) ---
# Esclusi: BTC (-3.2€), SOL (-8.4€), XRP (-11.3€), BNB (-12.8€)
# Inclusi: SUI (+16.4€), ADA (+15.9€), DOGE (+15.0€), ARB (+14.5€), AVAX (+14.3€), ETH (+9.2€), LINK (+8.8€)
TRADING_SYMBOLS=SUI,ADA,DOGE,ARB,AVAX,ETH,LINK

# --- TIMING CRITICO (sweet spot 5-7 min) ---
ALPHA_MIN_HOLD_MINUTES=5
ALPHA_MAX_HOLD_MINUTES=7

# --- Position Sizing (conservativo per $220 portfolio) ---
# Con 7 simboli, max 2 posizioni simultanee = $50 totali = 23% del portfolio
ALPHA_POSITION_USD=25
ALPHA_MAX_LEVERAGE=5

# --- MCTS (disabilitato - dati mostrano che abbassa performance) ---
# Paper trading: MCTS 45-50% aveva 54.7% WR vs 0% che aveva 55.6% WR
ALPHA_MIN_WIN_PROB=0.0

# --- Loop Intervals ---
ALPHA_SLOW_INTERVAL=60   # Controlla ogni minuto
ALPHA_FAST_INTERVAL=5    # Monitora ogni 5 secondi

# --- Interval ---
ALPHA_INTERVAL=15m

# --- HyperLiquid Credentials (da .env.baseline) ---
# NOTA: Questi devono essere copiati dal tuo .env.baseline
PRIVATE_KEY=${PRIVATE_KEY}
WALLET_ADDRESS=${WALLET_ADDRESS}
TESTNET=false

# --- Database ---
DATABASE_URL=${DATABASE_URL}

# ═══════════════════════════════════════════════════════════════════════════
# ANALISI CHE HA PORTATO A QUESTA CONFIGURAZIONE
# ═══════════════════════════════════════════════════════════════════════════
#
# DURATA TRADE (5-7 min sweet spot):
# - <5m:  WR 44.7%, avg -0.03%, totale -3.51
# - 5-7m: WR 56.3%, avg +0.21%, totale +291.04  <-- BEST
# - 7-9m: WR 50.2%, avg -0.03%, totale -6.86
# - >15m: WR 35.1%, avg -0.99%, totale -117.84
#
# SIMBOLI DOPO FEES (0.2€ per trade):
# Top 5:  SUI +16.4€, ADA +15.9€, DOGE +15.0€, ARB +14.5€, AVAX +14.3€
# OK:     ETH +9.2€, LINK +8.8€
# ESCLUSI: BTC -3.2€, SOL -8.4€, XRP -11.3€, BNB -12.8€
#
# MCTS: Dati mostrano che non migliora, anzi peggiora leggermente
#
# ═══════════════════════════════════════════════════════════════════════════
