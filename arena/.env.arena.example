# ═══════════════════════════════════════════════════════════════════════════════
# ARENA - Trading Simulation System Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# ─── MASTER SWITCH ───────────────────────────────────────────────────────────
# Enable/disable entire Arena system
ARENA_ENABLED=true

# ─── SIMULATION INTERVALS ────────────────────────────────────────────────────
# Slow loop interval (seconds) - checks for new entry signals
ARENA_LOOP_INTERVAL=60

# Fast loop interval (seconds) - monitors open positions
ARENA_FAST_LOOP_INTERVAL=5

# ─── DATABASE ────────────────────────────────────────────────────────────────
# Path to Arena database (default: data/arena.db)
# ARENA_DB_PATH=/path/to/arena.db

# ─── VARIANT CONTROL ─────────────────────────────────────────────────────────
# Enable/disable individual variants (comma-separated list)
# If empty or not set, uses enabled flag from variants.json
# ARENA_ENABLED_VARIANTS=V1_BASELINE,V2_MULTI_AI,V3_SMART_EXIT

# Disable specific variants (overrides variants.json)
# ARENA_DISABLED_VARIANTS=V5_AI_FREE

# ─── AI CONFIGURATION ────────────────────────────────────────────────────────
# OpenRouter API key (same key works for all models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter API base URL (default)
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Rate limiting (minimum seconds between AI calls per model)
ARENA_AI_RATE_LIMIT=1.0

# ─── LOGGING ─────────────────────────────────────────────────────────────────
# Log level for Arena (DEBUG, INFO, WARNING, ERROR)
ARENA_LOG_LEVEL=INFO

# Separate log file for Arena (optional)
# ARENA_LOG_FILE=/var/log/arena.log

# ─── DOCKER ──────────────────────────────────────────────────────────────────
# Run Arena in separate container (recommended)
ARENA_DOCKER_ENABLED=true

# ═══════════════════════════════════════════════════════════════════════════════
# VARIANT-SPECIFIC OVERRIDES (Optional)
# ═══════════════════════════════════════════════════════════════════════════════

# Override position size for all variants
# ARENA_POSITION_SIZE_USD=25.0

# Override leverage for all variants
# ARENA_LEVERAGE=2

# ═══════════════════════════════════════════════════════════════════════════════
# NOTES
# ═══════════════════════════════════════════════════════════════════════════════
#
# 1. Copy this file to .env and configure
# 2. Arena runs independently from the main trading bot
# 3. Arena uses SIMULATION only - no real trades
# 4. Edit arena/variants.json to customize variant configurations
# 5. Use CLI to manage: python -m arena.cli --help
#
