# ═══════════════════════════════════════════════════════════════════════════════
# ARENA - Trading Simulation System
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env in the project root and configure

# ─── MASTER SWITCH ───────────────────────────────────────────────────────────
ARENA_ENABLED=true

# ─── STARTING CAPITAL ────────────────────────────────────────────────────────
# Simulated starting capital for equity tracking (default: 100)
ARENA_STARTING_CAPITAL=100

# ─── DASHBOARD ───────────────────────────────────────────────────────────────
ARENA_DASHBOARD_ENABLED=true
ARENA_DASHBOARD_PORT=5050

# ─── SIMULATION INTERVALS ────────────────────────────────────────────────────
# Slow loop (seconds) - checks for new entry signals
ARENA_LOOP_INTERVAL=60

# Fast loop (seconds) - monitors open positions, SL/TP
ARENA_FAST_LOOP_INTERVAL=5

# ─── AI CONFIGURATION ────────────────────────────────────────────────────────
# OpenRouter API key (required for AI features)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxx

# ─── VARIANT CONTROL ─────────────────────────────────────────────────────────
# Disable specific variants (comma-separated, optional)
# Example: ARENA_DISABLED_VARIANTS=V5_AI_FREE,V4_INDICATOR_TEST
# ARENA_DISABLED_VARIANTS=

# ─── LOGGING ─────────────────────────────────────────────────────────────────
ARENA_LOG_LEVEL=INFO
