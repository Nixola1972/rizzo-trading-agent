# ===========================================
# CONFIGURAZIONE RIZZO TRADING BOT
# Con supporto OpenAI e OpenRouter
# ===========================================

# ----- AI PROVIDER -----
# Scegli quale usare: "openai" o "openrouter"
AI_PROVIDER=openai

# ----- OPENAI API -----
# Registrati su: https://platform.openai.com/api-keys
# Costo: ~$0.01-0.05 per decisione (modello gpt-4)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----- OPENROUTER API -----
# Registrati su: https://openrouter.ai/keys
# Supporta molti modelli: GPT-4, Claude, Gemini, etc.
# Spesso più economico di OpenAI diretto
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modello da usare con OpenRouter
# Esempi:
#   - openai/gpt-4-turbo          (simile a OpenAI, ~$0.01/req)
#   - anthropic/claude-3.5-sonnet (molto bravo, ~$0.015/req)
#   - google/gemini-pro-1.5       (economico, ~$0.001/req)
#   - meta-llama/llama-3.1-70b    (open source, ~$0.0005/req)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ----- HYPERLIQUID EXCHANGE -----
# Ottieni questi dal tuo wallet Ethereum
# ATTENZIONE: Non condividere mai la private key!
PRIVATE_KEY=0x1234567890abcdef...  # La tua chiave privata Ethereum (64 caratteri hex)
WALLET_ADDRESS=0xAbC123...          # Il tuo indirizzo wallet Ethereum (42 caratteri)

# ----- COINMARKETCAP API -----
# Registrati su: https://coinmarketcap.com/api/
# Piano gratuito: 10,000 chiamate/mese (più che sufficiente)
CMC_PRO_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ----- DATABASE POSTGRESQL (Container esistente: memory_postgres) -----
# Usa il container memory_postgres che hai già sul VPS
# Formato: postgresql://username:password@container_name:5432/database_name
DATABASE_URL=postgresql://tradingbot:TradingBot2025!Secure@memory_postgres:5432/rizzo_trading

# Network Docker del PostgreSQL (dalla tua analisi VPS)
POSTGRES_NETWORK=unified-memory-stack_memory-net

# ----- CONFIGURAZIONE BOT -----
# TESTNET: true = usa testnet (soldi finti), false = mainnet (soldi veri!)
TESTNET=true

# VERBOSE: mostra più informazioni nei log
VERBOSE=true
