# ===========================================
# CONFIGURAZIONE DOCKER - Rizzo Trading Agent
# ===========================================
# Copia questo file in .env e compila con i tuoi dati

# ----- DATABASE POSTGRESQL -----
POSTGRES_USER=tradingbot
POSTGRES_PASSWORD=change_this_strong_password_123
POSTGRES_DB=rizzo_trading

# ----- HYPERLIQUID EXCHANGE -----
PRIVATE_KEY=your_ethereum_private_key_here
WALLET_ADDRESS=your_ethereum_wallet_address_here

# ----- OPENAI API -----
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxx

# ----- COINMARKETCAP API -----
CMC_PRO_API_KEY=your_coinmarketcap_api_key_here

# ----- CONFIGURAZIONE BOT -----
TESTNET=true
VERBOSE=true
